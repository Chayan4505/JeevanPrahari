# ==============================================================================
# JeevanPrahari Environment Configuration Template (.env)
# ==============================================================================
# Copy this file to .env and supply keys where applicable.
# The app works out of the box with free fallback endpoints (Open-Meteo, NASA POWER, OSM).

# 1. Database & Infrastructure
POSTGRES_DB=jeevenprahari_db
POSTGRES_USER=jeevenprahari_user
POSTGRES_PASSWORD=jeevenprahari_secure_pass_2026
POSTGRES_PORT=5432

REDIS_PORT=6379
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# 2. Port Mapping
GATEWAY_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8080
ML_PORT=8000

# 3. Security Secrets
JWT_SECRET=jeevenprahari_ultra_secure_jwt_secret_key_ner_disaster_management_2026_x89

# ==============================================================================
# ACTION NEEDED FROM USER (External API Keys & Credentials)
# ==============================================================================

# [ACTION NEEDED] Google OAuth 2.0 Client ID (Free)
# Sign up: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=jeevenprahari-demo-client-id.apps.googleusercontent.com

# [ACTION NEEDED] OpenTopography API Key (Free)
# Sign up: https://opentopography.org/blog/introducing-api-keys-access-opentopography-global-datasets
OPENTOPOGRAPHY_API_KEY=

# [ACTION NEEDED] Fast2SMS API Key (Free tier for India SMS)
# Sign up: https://www.fast2sms.com/
FAST2SMS_API_KEY=

# [ACTION NEEDED] Firebase Cloud Messaging (FCM) Credentials Path (Free)
# Setup: https://console.firebase.google.com/
FCM_CREDENTIALS_PATH=

# [ACTION NEEDED] IMD API Key & Whitelisted IP
# Portal: https://api.imd.gov.in/ (Requires IP whitelisting approval)
# Default working fallback is active: Open-Meteo (open-meteo.com, no key required)
IMD_API_KEY=

# [ACTION NEEDED] Sentinel Hub / Copernicus API Key (Free Tier)
# Sign up: https://www.sentinel-hub.com/
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
